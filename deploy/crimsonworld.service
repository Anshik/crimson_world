[Unit]
Description=CrimsonWorld Tovilis game
After=network.target

[Service]
Type=simple
User=crimsonworld
Group=crimsonworld
WorkingDirectory=/opt/crimsonworld/current
EnvironmentFile=/etc/crimsonworld.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/crimsonworld/venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:8088 --timeout 30 --max-requests 1000 --max-requests-jitter 100 --access-logfile - --error-logfile - server.app:app
Restart=on-failure
RestartSec=3
StateDirectory=crimsonworld
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/crimsonworld /opt/game/data

[Install]
WantedBy=multi-user.target
