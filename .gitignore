# Publish only application code and its maintained supporting files.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/game/
!/server/
!/tests/
!/deploy/
!/assets/
!/docs/
!/tools/

/assets/*
!/assets/characters/
!/assets/illustrations/
!/assets/maps/
/assets/characters/*
!/assets/characters/dwarf-directions-v2.png
/assets/illustrations/*
!/assets/illustrations/equipment-v1.png
!/assets/illustrations/events-v1.png
!/assets/illustrations/finds-v1.png
!/assets/illustrations/items-v1.png
!/assets/illustrations/miller-v3.png
!/assets/illustrations/places-v1.png
!/assets/illustrations/portraits-v1.png
/assets/maps/*
!/assets/maps/geometry/
!/assets/maps/working/
/assets/maps/geometry/*
!/assets/maps/geometry/tovilis-v9.json
/assets/maps/working/*
!/assets/maps/working/tovilis-v9.png
!/assets/maps/working/tovilis-v9.json
/docs/*
!/docs/DEPLOYMENT.md
!/docs/TOVILIS_MAP.md
!/docs/tovilis-map-data.js
!/docs/tovilis-map.html
!/docs/tovilis-map.css
!/docs/tovilis-map.js
!/docs/rules/
/docs/rules/*
!/docs/rules/notices-index.json
/tools/*
!/tools/build_tovilis_map.py
!/tools/validate_tovilis_map.py

# Local credentials and generated/runtime state must never be published.
.env
.env.*
!.env.example
secret.txt
*.pem
*.key
*.sqlite
*.sqlite-*
*.db
*.db-*
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
dist/
build/
*.log
.cache/
.pytest_cache/
.coverage
coverage/
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
~$*
